{
  "annotations": {
    "list": []
  },
  "description": "Tier failover: breaker state, fallbacks, per-tier outcomes and latency, synthesis cache. See docs/operations.md, Failover on-call.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Breakers",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "open",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "half-open",
                  "color": "yellow",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "title": "Breaker state per tier",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "max by (alias, tier) (airllm_breaker_state{alias=~\"$alias\"})",
          "legendFormat": "{{alias}} · tier {{tier}}",
          "refId": "A"
        }
      ],
      "description": "Closed, open (quarantined) or half-open (one probe let through). Read from the shared breaker state; max across replicas, since each replica only reports the tiers it has served since it started. Only tiers with the breaker switched on appear."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Breaker transitions",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (alias, tier, to) (increase(airllm_breaker_transitions_total{alias=~\"$alias\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} · tier {{tier}} → {{to}}",
          "refId": "A"
        }
      ],
      "description": "State changes per interval. Repeated open → half_open → open is a tier whose probes keep failing; each re-trip doubles its cooldown."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Fallbacks by origin → destination and reason",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (alias, from_tier, to_tier, reason) (rate(airllm_tier_fallbacks_total{alias=~\"$alias\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} · {{from_tier}} → {{to_tier}} ({{reason}})",
          "refId": "A"
        }
      ],
      "description": "Requests that moved past a tier, by the tier that served them in the end (none: nothing did) and why. reason=quarantined is a tier skipped by its open breaker, reason=unavailable one skipped while its provider and model are marked down."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 5,
      "panels": [],
      "title": "Tiers",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Tier outcomes",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (alias, tier, outcome) (rate(airllm_tier_outcomes_total{alias=~\"$alias\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} · tier {{tier}} {{outcome}}",
          "refId": "A"
        }
      ],
      "description": "Attempts per tier: success, failure (counts against the tier), request_error (the request's fault, no verdict) quarantined (skipped by its breaker) and unavailable (skipped while its provider and model are marked down); neither makes a call."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Tier failure ratio",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (alias, tier) (rate(airllm_tier_outcomes_total{alias=~\"$alias\", outcome=\"failure\"}[$__rate_interval])) / sum by (alias, tier) (rate(airllm_tier_outcomes_total{alias=~\"$alias\", outcome=~\"success|failure\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} · tier {{tier}}",
          "refId": "A"
        }
      ],
      "description": "Failures among the attempts that gave a verdict on the tier."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Tier latency p50",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.5, sum by (le, alias, tier, outcome) (rate(airllm_tier_attempt_duration_seconds_bucket{alias=~\"$alias\", outcome=~\"success|failure\"}[$__rate_interval])))",
          "legendFormat": "{{alias}} · tier {{tier}} {{outcome}}",
          "refId": "A"
        }
      ],
      "description": "Time from an attempt's start to its verdict — for a stream, its first chunk. A failure line sitting at the tier's time budget is a tier that hangs rather than errors."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Tier latency p95",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by (le, alias, tier, outcome) (rate(airllm_tier_attempt_duration_seconds_bucket{alias=~\"$alias\", outcome=~\"success|failure\"}[$__rate_interval])))",
          "legendFormat": "{{alias}} · tier {{tier}} {{outcome}}",
          "refId": "A"
        }
      ],
      "description": "Time from an attempt's start to its verdict — for a stream, its first chunk. A failure line sitting at the tier's time budget is a tier that hangs rather than errors."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 10,
      "panels": [],
      "title": "Synthesis cache",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Synthesis cache hit rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (alias) (rate(airllm_synthesis_cache_total{alias=~\"$alias\", outcome=\"hit\"}[$__rate_interval])) / sum by (alias) (rate(airllm_synthesis_cache_total{alias=~\"$alias\"}[$__rate_interval]))",
          "legendFormat": "{{alias}}",
          "refId": "A"
        }
      ],
      "description": "Share of answered synthesis requests served from the cache; a cache error counts as a miss. Empty until a gateway with the synthesis cache serves an alias that has it switched on."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "id": 12,
      "panels": [],
      "title": "LCR routing",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Target price (USD / 1M tokens)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "max by (provider, upstream_model) (airllm_target_price_usd_per_1m{provider=~\"$provider\"})",
          "legendFormat": "{{provider}} · {{upstream_model}}",
          "refId": "A"
        }
      ],
      "description": "LCR price proxy (input + output rate per 1M tokens) for each target an lcr-strategy alias has actually ranked; set when a request orders that tier, so a target with no recent lcr traffic has no line. Unpriced targets are excluded here (they sort last in ranking, never shown as free)."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "id": 14,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Target availability (live EWMA)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "max by (provider, upstream_model) (airllm_target_availability{provider=~\"$provider\"})",
          "legendFormat": "{{provider}} · {{upstream_model}}",
          "refId": "A"
        }
      ],
      "description": "Live EWMA success rate per target, the same signal lcr_mode=availability/both ranks by; set when a request orders that tier. A cold-started target with no recent history reads 1.0, same as the ranking sees it."
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "airllm"
  ],
  "templating": {
    "list": [
      {
        "current": {},
